# ProofLens web environment — pre-filled for local development.
# Copy to .env:
#
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# VITE_API_BASE: use http://localhost:8080 when running the API locally,
#                or https://proof-lens-production.up.railway.app to point at the hosted API.

VITE_API_BASE=http://localhost:8080
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_S3_PUBLIC_BASE=https://your-bucket.s3.your-region.amazonaws.com

# Mobile QR handoff — only needed if running a local Expo dev server
VITE_EXPO_DEV_URL=
VITE_EXPO_TUNNEL_URL=
VITE_EXPO_DEV_HOST=
VITE_EXPO_DEV_PORT=8081
VITE_EXPO_PROD_DEEP_LINK=
