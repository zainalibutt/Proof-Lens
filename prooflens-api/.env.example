# ProofLens API environment template — for local full-stack reproduction only.
# The hosted Railway deployment is pre-configured and does not require this file.
#
# Copy to .env:
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Sensitive values (obtain from your own infrastructure — never commit real values):
#   SUPABASE_SERVICE_KEY — Supabase dashboard: Settings → API → service_role key
#   EVIDENCE_BUNDLE_HMAC_SECRET — REQUIRED. Must be an independent random value
#     of at least 32 characters. Reusing SUPABASE_SERVICE_KEY is rejected at runtime.
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — IAM user (see database/iam_policy.json)

PORT=8080
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key bypasses RLS — never expose to any client
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

AWS_REGION=your-aws-region
S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

TSA_URL=https://freetsa.org/tsr
TSA_CA_CERT_PATH=certs/tsa-ca.pem
TSA_UPLOAD_SIDECAR=true
OPENSSL_BIN=openssl
TSA_BEARER=
TSA_BASIC=

SHARE_BASE_URL=http://localhost:5173
EVIDENCE_BUNDLE_HMAC_SECRET=replace-with-independent-random-secret-min-32-chars

# Optional admin gate for POST /admin/tsa-retry
# Provide at least one of these to allow access.
ADMIN_TSA_RETRY_SECRET=
ADMIN_TSA_RETRY_USER_IDS=
