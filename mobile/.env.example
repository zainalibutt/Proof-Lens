# ProofLens mobile environment — template. Replace every placeholder with your own infrastructure values.
# Copy to .env and fill in your own values before running.
#
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env

EXPO_PUBLIC_API_BASE=https://your-api-host.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_WEB_BASE=https://your-web-host.example.com
